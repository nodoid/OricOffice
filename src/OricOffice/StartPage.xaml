<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OricOffice.StartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:OricOffice.MauiShared.Localization;assembly=OricOffice.MauiShared"
    xmlns:shared="clr-namespace:OricOffice.MauiShared.Controls;assembly=OricOffice.MauiShared"
    Title="">

    <Grid
        RowDefinitions="Auto,1*,Auto,Auto,Auto"
        RowSpacing="0"
        BackgroundColor="{StaticResource Suite.CanvasBrush}">

        <!-- Menu row: native menu bar on desktop (hidden here), tap-to-open on tablets -->
        <shared:SuiteMenuBarView x:Name="CustomMenuBar" Grid.Row="0" ItemsSource="{Binding Menus}" />

        <!-- Start center: pick an application -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="40,48" Spacing="10" VerticalOptions="Center">

                <Label
                    HorizontalOptions="Center"
                    FontFamily="OpenSansSemibold"
                    FontSize="30"
                    Text="{loc:Translate Start.Title}"
                    TextColor="{StaticResource Suite.TextBrush}" />

                <Label
                    Margin="0,0,0,34"
                    HorizontalOptions="Center"
                    Style="{StaticResource Suite.Hint}"
                    Text="{loc:Translate Start.Choose}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="28">

                    <!-- Author -->
                    <Border
                        Padding="26,30"
                        BackgroundColor="{StaticResource Suite.SurfaceBrush}"
                        Stroke="{StaticResource Suite.GridLineBrush}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        WidthRequest="224"
                        HeightRequest="268">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenAuthor" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                            <Image
                                HeightRequest="104"
                                Source="author.png"
                                VerticalOptions="Center" />
                            <Label
                                HorizontalOptions="Center"
                                FontFamily="OpenSansSemibold"
                                FontSize="17"
                                Text="Author" />
                            <Label
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Suite.Hint}"
                                Text="{loc:Translate Start.AuthorHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Calc -->
                    <Border
                        Padding="26,30"
                        BackgroundColor="{StaticResource Suite.SurfaceBrush}"
                        Stroke="{StaticResource Suite.GridLineBrush}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        WidthRequest="224"
                        HeightRequest="268">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenCalc" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                            <Image
                                HeightRequest="104"
                                Source="calc.png"
                                VerticalOptions="Center" />
                            <Label
                                HorizontalOptions="Center"
                                FontFamily="OpenSansSemibold"
                                FontSize="17"
                                Text="Calc" />
                            <Label
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Suite.Hint}"
                                Text="{loc:Translate Start.CalcHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Base -->
                    <Border
                        Padding="26,30"
                        BackgroundColor="{StaticResource Suite.SurfaceBrush}"
                        Stroke="{StaticResource Suite.GridLineBrush}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        WidthRequest="224"
                        HeightRequest="268">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenBase" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                            <Image
                                HeightRequest="104"
                                Source="base.png"
                                VerticalOptions="Center" />
                            <Label
                                HorizontalOptions="Center"
                                FontFamily="OpenSansSemibold"
                                FontSize="17"
                                Text="Base" />
                            <Label
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Suite.Hint}"
                                Text="{loc:Translate Start.BaseHint}" />
                        </VerticalStackLayout>
                    </Border>

                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Recent documents (built by the code-behind) -->
        <VerticalStackLayout x:Name="RecentSection" Grid.Row="2" Padding="40,0,40,14" Spacing="8" IsVisible="False">
            <Label
                x:Name="RecentHeader"
                FontFamily="OpenSansSemibold"
                FontSize="13"
                Text="Recent documents"
                TextColor="{StaticResource Suite.TextBrush}" />
            <HorizontalStackLayout x:Name="RecentRow" Spacing="8" />
        </VerticalStackLayout>

        <!-- Language switcher (buttons built by the code-behind) -->
        <HorizontalStackLayout
            x:Name="LanguageRow"
            Grid.Row="3"
            Padding="40,6,40,2"
            Spacing="8">
            <Label
                VerticalOptions="Center"
                Style="{StaticResource Suite.Hint}"
                Text="{loc:Translate Start.Language}" />
        </HorizontalStackLayout>

        <!-- Status bar -->
        <Label
            Grid.Row="4"
            Style="{StaticResource Suite.StatusBar}"
            Text="{loc:Translate Start.Footer}" />
    </Grid>
</ContentPage>
